{
  "name": "hassio-1password-addon",
  "version": "0.4.0",
  "private": true,
  "description": "1Password for Home Assistant",
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "dev": "next dev -p 8000",
    "lint": "oxlint",
    "migration:dev": "prisma migrate dev",
    "migration:prod": "prisma migrate deploy",
    "prebuild": "prisma generate",
    "prettier": "prettier --check ./src ./messages",
    "prettier:fix": "prettier --write ./src ./messages",
    "prisma:generate": "prisma generate",
    "start": "next start -p 8000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@1password/op-js": "^0.1.13",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "glob": "^14.0.4",
    "home-assistant-js-websocket": "^9.8.1",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "prisma-extension-pagination": "^0.7.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "prettier-plugin-package": "^2.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.11"
}
