{
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "auto",
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-package",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindFunctions": ["tv", "clsx"]
}
